{
  "expo": {
    "name": "Xander",
    "slug": "xander-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.berryhill.xander",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Xander needs access to speech recognition to understand your voice commands.",
        "NSMicrophoneUsageDescription": "Xander needs access to the microphone to hear your voice."
      }
    },
    "android": {
      "package": "com.berryhill.xander",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Xander needs access to the microphone to hear your voice.",
          "speechRecognitionPermission": "Xander needs access to speech recognition to understand your voice commands.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
